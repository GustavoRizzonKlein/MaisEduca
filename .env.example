# Use a publishable key (sb_publishable_...).
# Nunca coloque service_role / sb_secret_... neste arquivo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signup público é bloqueado no banco (auth.users exige app_metadata.role).
# Contas gerenciáveis são criadas pela Edge Function manage-users via RPC service_role.
